# ---- Servidor (nunca expor ao navegador; na Vercel, configure em Settings > Environment Variables) ----
# Token pessoal ou de app da monday com permissão de LEITURA nos 3 quadros.
MONDAY_API_TOKEN=

# Ids dos quadros (valores padrão de desenvolvimento já embutidos; preencha só para trocar).
MONDAY_INFOPRODUCTS_BOARD_ID=18433730926
MONDAY_COURSES_BOARD_ID=18433759798
MONDAY_YOUTUBE_BOARD_ID=18426268819

# Criar colunas Connect Boards (conexões) exige a versão 2025-10 ou mais nova da API.
MONDAY_API_VERSION=2025-10

# Escrita na monday (criar/editar/duplicar/excluir/conectar). 0 deixa a implantação SOMENTE LEITURA.
# MONDAY_WRITE_ENABLED=1
# ---- Alterações ESTRUTURAIS (criar tipo de conteúdo = criar board; criar conexão = criar coluna) ----
# Em desenvolvimento (fora da Vercel) vêm habilitadas; na Vercel precisam de MONDAY_STRUCTURE_ENABLED=1 E de uma chave.
# MONDAY_STRUCTURE_ENABLED=1
# Chave de administração exigida no cabeçalho x-admin-key (obrigatória na Vercel quando a estrutura está habilitada).
# SCHEMA_ADMIN_KEY=
# Boards do registry (opcional: por padrão são localizados pelo nome na pasta do cérebro).
# MONDAY_SCHEMA_NODETYPES_BOARD_ID=
# MONDAY_SCHEMA_CONNECTIONS_BOARD_ID=

# Hosts extras aceitos nas gravações (POST /api/mutate), separados por vírgula. O host da própria requisição já é aceito.
# ALLOWED_ORIGINS=

# Cache em memória do servidor, em segundos (padrão 30). 0 desliga.
# MONDAY_CACHE_SECONDS=30

# ---- Assistente (IA) ----
# Chave da OpenAI: SOMENTE servidor (nunca com prefixo VITE_). Sem ela, o assistente fica desabilitado e o resto do app funciona.
OPENAI_API_KEY=
# Modelo (padrão gpt-5.4-mini: bom custo/desempenho para interpretar texto e chamar funções).
# OPENAI_MODEL=gpt-5.4-mini
# AI_ENABLED=0 desliga o assistente mesmo com a chave configurada.
# AI_ENABLED=1
# Voltas máximas do ciclo de ferramentas por pedido (padrão 10).
# AI_MAX_STEPS=10

# ---- Cliente (valores públicos, embutidos no build) ----
# Fonte de dados da interface: monday | mock. Padrão: monday em produção, mock em desenvolvimento.
VITE_DATA_SOURCE=monday  # padrão; use mock só para desenvolvimento sem monday
# Somente desenvolvimento: oferece "Usar demonstração" quando a monday falha.
# VITE_ALLOW_MOCK_FALLBACK=1

